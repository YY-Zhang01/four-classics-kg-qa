# 配置模板：复制到【项目根目录】的 .env，再按需修改。
#   PowerShell:  Copy-Item config\.env.example .env
# .env 已被 .gitignore 忽略，绝不进 git。

# ── 大模型接入（OpenAI 兼容接口）───────────────────────────
# 默认：本地 Ollama，本地优先、零外部依赖。
#   1) 装 Ollama 并拉模型：ollama pull qwen2.5:7b
#   2) 保证本地服务在跑：ollama serve
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=120
LLM_PROVIDER=gateway

# ── 项目标识 ──────────────────────────────────────────────
# 换文档时改这两个值：名称和领域
PROJECT_NAME=红楼梦问答
PROJECT_DOMAIN=红楼梦

# ── 领域配置（换书时同步修改） ─────────────────────────────
# 人物实体词典：config/entities.json  （KG 实体提取用）
# 前端 UI 配置：config/domain.json      （印章字、示例问题）

# ── 管理后台鉴权 ──────────────────────────────────────────
# 访问 /admin 需要此 Token（通过 Bearer Authorization 头）。
# Demo 用简单 token；生产环境请换强随机值 / OAuth。
# 留空 = 跳过鉴权（仅开发期）。
ADMIN_TOKEN=demo-admin-token
RETRIEVER=fusion
# embedding 模型（需先在 Ollama 拉取：ollama pull bge-m3）
EMBED_MODEL=bge-m3
# 向量维度由模型决定（bge-m3 = 1024），代码自动适配
# 召回块数（运行时可通过管理后台热调整，无需重启）
TOP_K=5

# ── 切块参数 ──────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ── 本地 PostgreSQL（P1 起必需）───────────────────────────
# 需先创建专用库和账号（脚本见 scripts/db_schema.sql）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=reddream
PG_USER=reddream_app
PG_PASSWORD=你的密码
