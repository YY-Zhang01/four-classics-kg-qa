{
  "_说明": "古典文学知识图谱 Schema（关系骨架四大名著通用，人物示例以红楼梦为基准）—— 节点类型、关系类型、关系白名单。抽取时严格校验。",

  "节点类型": {
    "Person": {
      "label": "人物",
      "属性": ["name（姓名）", "alias（别名，如'颦儿''宝二爷'）", "gender（性别：男/女）", "family（所属家族：贾/王/史/薛/其他）", "role（身份：主子/丫鬟/仆从/亲戚/其他）"],
      "示例": "林黛玉·女·贾府亲戚·别名'颦儿''潇湘妃子'"
    },
    "Family": {
      "label": "家族",
      "属性": ["name（族名：贾府/王府/史府/薛府）", "rank（地位：国公/皇商/其他）"],
      "示例": "贾府·国公府"
    },
    "Event": {
      "label": "事件",
      "属性": ["name（事件名）", "chapter（所在回目）", "type（事件类型：节日/丧事/婚事/诗社/其他）"],
      "示例": "元妃省亲·第十八回·节日"
    },
    "Place": {
      "label": "地点",
      "属性": ["name（地名）", "type（类型：府邸/院落/园林/寺庙/其他）"],
      "示例": "潇湘馆·院落"
    }
  },

  "关系类型": {
    "亲属": {
      "说明": "血缘或婚姻关系",
      "子类型": ["父亲", "母亲", "儿子", "女儿", "兄弟", "姐妹", "夫妻", "妾室",
                "表哥", "表弟", "表姐", "表妹", "堂哥", "堂弟", "堂姐", "堂妹",
                "祖母", "祖父", "外祖母", "外祖父", "舅舅", "舅母", "姑姑", "姨妈",
                "嫂子", "弟媳", "姐夫"],
      "方向": "父→子是'父亲'，子→父是'儿子'，双向各自建边"
    },
    "主仆": {
      "说明": "主人与丫鬟/仆从关系",
      "子类型": ["主人", "丫鬟", "仆从", "管家"],
      "备注": "只抽明确的贴身关系，如贾宝玉-晴雯、王熙凤-平儿"
    },
    "居住": {
      "说明": "人物居住在某地",
      "子类型": ["住在"],
      "示例": "林黛玉-住在-潇湘馆"
    },
    "暧昧": {
      "说明": "非正式的情感关系",
      "子类型": ["钟情", "暗恋", "知己"],
      "示例": "贾宝玉-钟情-林黛玉"
    },
    "参与": {
      "说明": "人物参与某事件",
      "子类型": ["参与", "主持"],
      "示例": "王熙凤-主持-秦可卿丧事"
    },
    "创作": {
      "说明": "人物创作诗词",
      "子类型": ["写了"],
      "示例": "林黛玉-写了-葬花吟"
    },
    "社交": {
      "说明": "非血缘、非主仆的社交关系",
      "子类型": ["朋友", "师生", "结拜"],
      "示例": "林黛玉-师生-贾雨村"
    }
  },

  "关系白名单": [
    "父亲", "母亲", "儿子", "女儿",
    "兄弟", "姐妹",
    "夫妻", "妾室",
    "表哥", "表弟", "表姐", "表妹",
    "堂哥", "堂弟", "堂姐", "堂妹",
    "祖母", "祖父", "外祖母", "外祖父",
    "舅舅", "舅母", "姑姑", "姨妈",
    "嫂子", "弟媳", "姐夫",
    "主人", "丫鬟", "仆从", "管家",
    "住在",
    "钟情", "暗恋", "知己",
    "参与", "主持",
    "写了",
    "朋友", "师生", "结拜"
  ],

  "核心人物参考": [
    "贾宝玉", "林黛玉", "薛宝钗", "王熙凤",
    "贾母", "贾政", "王夫人", "邢夫人",
    "贾元春", "贾迎春", "贾探春", "贾惜春",
    "史湘云", "妙玉", "李纨", "秦可卿", "巧姐",
    "贾琏", "贾珍", "贾蓉", "贾环", "贾兰",
    "薛姨妈", "薛蟠", "薛宝琴",
    "尤氏", "尤二姐", "尤三姐",
    "晴雯", "袭人", "麝月", "平儿", "鸳鸯", "紫鹃", "司棋",
    "刘姥姥", "贾雨村"
  ]
}
